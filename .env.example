# ============================================================
#  mall-agent 环境变量配置模板
#
#  用法：
#    1. 复制本文件为 .env
#       Windows:  copy .env.example .env
#       Linux/mac: cp .env.example .env
#    2. 填写下方密钥
#    3. 重启服务
#
#  注意：.env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================


# ── 大模型（阿里云百炼 DashScope，OpenAI 兼容接口）────────────

# 申请入口：https://bailian.console.aliyun.com/  →  右上角「API-KEY」→ 创建
# 密钥形如 sk-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# 接口地址：使用阿里云百炼时必须保持下面这个值
# 如改用 OpenAI 官方，填 https://api.openai.com/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称：
#   qwen-plus  ← 推荐，效果与速度平衡
#   qwen-turbo ← 更快更便宜，复杂推理稍弱
#   qwen-max   ← 能力最强，费用更高
OPENAI_MODEL=qwen-plus


# ── 高德地图 ───────────────────────────────────────────────

# 申请入口：https://console.amap.com/dev/key/app  →  创建新应用 → 添加 Key
# 重要：类型必须选「Web服务」，不要选「Web端(JS API)」
#       选错会返回 INVALID_USER_KEY，POI 搜索和地图全部不可用
AMAP_KEY=


# ── 可选项，不填不影响基本功能 ─────────────────────────────

# 视觉理解模型：上传照片识别景点/地标，需百炼已开通该模型
# qwen3-vl-plus / qwen-vl-max 均可，默认 qwen3-vl-plus
# VISION_MODEL=qwen3-vl-plus

# 高德 Web端(JS API) Key + 安全密钥
# 填写后，地图面板会从静态图片升级为可交互地图
# AMAP_JS_KEY=
# AMAP_SECURITY_CODE=

# 开发模式：设为 1 时输出更详细的调试日志
# DEV_MODE=0

# 服务监听端口，默认 7860
# PORT=7860

# 会话数据库路径，默认 data/chat.db（相对项目根目录）
# CHAT_DB_PATH=data/chat.db
