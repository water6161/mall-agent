# ─── 大模型（OpenAI 兼容；阿里云百炼 / OpenAI / 其他代理均可）───
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选：视觉理解模型（用于上传图片的内容识别），如 qwen3-vl-plus
# VISION_MODEL=qwen3-vl-plus

# 可选：AI 修图 / 文生图模型，默认 qwen-image-3.0
# IMAGE_MODEL=qwen-image-3.0

# ─── 高德地图 ───
# 必填：Web 服务 Key（POI 搜索 / 路线 / 静态地图）
AMAP_KEY=your_amap_web_service_key_here

# 可选：Web端(JS API) Key + 安全密钥，配置后地图面板自动升级为可交互地图
# AMAP_JS_KEY=your_amap_js_api_key_here
# AMAP_SECURITY_CODE=your_amap_security_code_here

# ─── 其他 ───
# DEV_MODE=0
# PORT=7860
# CHAT_DB_PATH=data/chat.db
